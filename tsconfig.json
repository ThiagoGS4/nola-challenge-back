{
  "compilerOptions": {
    "target": "ES2022",                // Compila para uma versão moderna do JS
    "module": "NodeNext",             // Usa o sistema de módulos moderno do Node
    "moduleResolution": "NodeNext",   // Como o módulo acima, resolve os imports
    "outDir": "./dist",               // Onde o JavaScript compilado será salvo
    "rootDir": "./src",               // Onde seu código-fonte TypeScript está
    "esModuleInterop": true,          // Permite interoperabilidade com módulos CommonJS
    "forceConsistentCasingInFileNames": true,
    "strict": true,                   // Habilita todas as checagens estritas de tipo
    "skipLibCheck": true,             // Pula a verificação de tipos em arquivos .d.ts
    "sourceMap": true                 // Gera "mapas" para facilitar o debug
  },
  "include": ["src/**/*"],            // Quais arquivos o TS deve "olhar"
  "exclude": ["node_modules"]         // Quais pastas ele deve ignorar
}